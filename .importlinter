[importlinter]
root_package = jarvis

# --- Layer contract (Technical Bible Part 1 §B.1) ------------------------
#
# Five layers, top to bottom. A module may import its own layer and any
# layer strictly below; never above.
#
# DEVIATION FROM THE LITERAL WORDING OF WP-000-CORRECTION, DOCUMENTED PER
# ITS OWN "stop and report" INSTRUCTION:
#
# The correction text says both (a) "modules within a layer may depend on
# each other -- this is not a strict chain" and (b) "use import-linter's
# independent-layer-group syntax". These two instructions conflict for this
# tool. In import-linter's `layers` contract, sibling modules on one line
# joined with `|` are *independent*, meaning imports BETWEEN them are
# FORBIDDEN (see importlinter/contracts/layers.py and
# grimp/application/graph.py: "should imports between sibling modules be
# forbidden (default) or allowed?" -- forbidden is the `|` / independent
# case). Siblings joined with `:` are non-independent, meaning imports
# between them ARE allowed. Using `|` ("independent-layer-group syntax" as
# named in the correction) would silently forbid the intra-layer imports
# that rule (a) explicitly requires. I have followed the explicit prose
# rule (a) and used `:` below, since that is the stated *behaviour*
# requirement, not the possibly-mislabelled syntax name. If "independent"
# was actually intended, swap every `:` below for `|`.
[importlinter:contract:layers]
name = Five-layer architecture (Technical Bible Part 1 §B.1)
type = layers
layers =
    jarvis.cli : jarvis.reporting
    jarvis.describe : jarvis.backtest : jarvis.statistics : jarvis.robustness : jarvis.forward : jarvis.probe
    jarvis.experiments : jarvis.vault
    jarvis.features : jarvis.strategies : jarvis.strategy_impls : jarvis.opportunities : jarvis.execution
    jarvis.core : jarvis.provenance : jarvis.timeengine : jarvis.sessions : jarvis.events : jarvis.ingest : jarvis.bars : jarvis.qa

# --- Purity rule (Part 1 §B.1) --------------------------------------------
# features, strategies and opportunities may not import the research /
# research-control layers, even though layer ordering alone already
# forbids this. Named explicitly so a violation reports "purity rule"
# rather than a generic layer-violation message.
[importlinter:contract:purity-rule]
name = purity rule
type = forbidden
source_modules =
    jarvis.features
    jarvis.strategies
    jarvis.opportunities
forbidden_modules =
    jarvis.experiments
    jarvis.statistics
    jarvis.robustness
    jarvis.backtest
    jarvis.reporting

# --- Named forbidden-dependency pairs (Part 1 §B.3) -----------------------

[importlinter:contract:provenance-isolation]
name = provenance depends on nothing but core
type = forbidden
source_modules =
    jarvis.provenance
forbidden_modules =
    jarvis.timeengine
    jarvis.sessions
    jarvis.events
    jarvis.ingest
    jarvis.bars
    jarvis.qa
    jarvis.features
    jarvis.strategies
    jarvis.strategy_impls
    jarvis.opportunities
    jarvis.execution
    jarvis.vault
    jarvis.experiments
    jarvis.describe
    jarvis.backtest
    jarvis.statistics
    jarvis.robustness
    jarvis.forward
    jarvis.reporting
    jarvis.cli

# WP-017/D-066: this contract's target used to be `jarvis.bars.storage`, a
# module that never existed -- the real Parquet/DuckDB access points that
# were actually built are `jarvis.bars.store` (BAR_SCHEMA, bars_path,
# read_bars, write_bars) and `jarvis.bars.resample` (which also reads tick
# Parquet directly, via `jarvis.ingest.histdata_import.tick_path`, and
# calls write_bars). Both are internal implementation submodules of `bars`
# whose public surface is re-exported through `jarvis.bars.__init__` --
# confirmed directly, not assumed, by reading both files. Import-linter
# silently skips forbidden targets that don't exist in the graph, so this
# contract was vacuously KEPT (passing by matching nothing) from before
# Stage 0 finished until this fix.
#
# allow_indirect_imports = true is deliberate, not a loophole: the rule's
# intent is "don't bypass bars's public interface and touch bars.store
# directly," not "no module may ever transitively cause bars.store to be
# imported." Without this flag, `jarvis.bars.__init__` re-exporting from
# `jarvis.bars.store` (so callers can do `from jarvis.bars import
# read_bars`, the SANCTIONED path) makes every legitimate consumer of
# `jarvis.bars`'s public API count as an indirect chain into bars.store,
# and the contract fails almost universally -- confirmed directly: with
# this flag absent, `jarvis.qa.report -> jarvis.bars -> jarvis.bars.store`
# (a legitimate, sanctioned `from jarvis.bars import read_bars`) was
# flagged identically to `jarvis.cli.main -> jarvis.bars.store` (a real
# bypass, direct `from jarvis.bars.store import read_bars`). With the flag,
# only the direct-import case is caught, which is what "only bars and
# vault may access data/ storage" actually means.
[importlinter:contract:single-reader-rule]
name = single-reader rule: only bars and vault may access data/ storage
type = forbidden
source_modules =
    jarvis.core
    jarvis.provenance
    jarvis.timeengine
    jarvis.sessions
    jarvis.events
    jarvis.ingest
    jarvis.qa
    jarvis.features
    jarvis.strategies
    jarvis.strategy_impls
    jarvis.opportunities
    jarvis.execution
    jarvis.experiments
    jarvis.describe
    jarvis.backtest
    jarvis.statistics
    jarvis.robustness
    jarvis.forward
    jarvis.reporting
    jarvis.cli
forbidden_modules =
    jarvis.bars.store
    jarvis.bars.resample
allow_indirect_imports = true

[importlinter:contract:ingest-restriction]
name = single-reader: ingest cannot read bars
type = forbidden
source_modules =
    jarvis.ingest
forbidden_modules =
    jarvis.bars
    jarvis.qa
    jarvis.features
    jarvis.strategies
    jarvis.strategy_impls
    jarvis.opportunities
    jarvis.execution
    jarvis.experiments
    jarvis.vault
    jarvis.describe
    jarvis.backtest
    jarvis.statistics
    jarvis.robustness
    jarvis.forward
    jarvis.reporting
    jarvis.cli

[importlinter:contract:bars-vault-circularity]
name = bars cannot depend on vault (circular)
type = forbidden
source_modules =
    jarvis.bars
forbidden_modules =
    jarvis.vault

[importlinter:contract:features-restriction]
name = features cannot depend on bars directly
type = forbidden
source_modules =
    jarvis.features
forbidden_modules =
    jarvis.bars

[importlinter:contract:strategies-restriction]
name = strategies cannot depend on execution, experiments, statistics, or vault
type = forbidden
source_modules =
    jarvis.strategies
forbidden_modules =
    jarvis.execution
    jarvis.experiments
    jarvis.statistics
    jarvis.vault

[importlinter:contract:execution-restriction]
name = execution cannot depend on strategies or opportunities
type = forbidden
source_modules =
    jarvis.execution
forbidden_modules =
    jarvis.strategies
    jarvis.opportunities

# Placeholder: `experiments` has no `ledger` submodule yet (it is still an
# empty skeleton per WP-000), so "vault may depend on experiments.ledger
# but nothing else in experiments" cannot be expressed precisely today --
# forbidding all of `jarvis.experiments` would block the future unlock-record
# access the correction describes, and forbidding nothing would not
# encode the restriction at all. Until `experiments.ledger` exists, this
# contract permits `jarvis.experiments` as a whole (already allowed by the
# layer contract, since vault and experiments share L3) and revisit this
# once `experiments.ledger` exists so only that submodule stays permitted.
[importlinter:contract:vault-restriction]
name = vault depends on nothing beyond core, bars, and experiments.ledger
type = forbidden
source_modules =
    jarvis.vault
forbidden_modules =
    jarvis.provenance
    jarvis.timeengine
    jarvis.sessions
    jarvis.events
    jarvis.ingest
    jarvis.qa
    jarvis.features
    jarvis.strategies
    jarvis.strategy_impls
    jarvis.opportunities
    jarvis.execution
    jarvis.describe
    jarvis.backtest
    jarvis.statistics
    jarvis.robustness
    jarvis.forward
    jarvis.reporting
    jarvis.cli

# --- WP-008: probe must never compute profitability ------------------------
# Stage 0's job is frequency only. This contract makes that mechanical
# rather than a matter of discipline: probe has no import path to anything
# that could produce a PnL/R/expectancy/win-rate proxy, now or in any
# future edit to this package.
[importlinter:contract:probe-purity]
name = probe must not compute profitability
type = forbidden
source_modules =
    jarvis.probe
forbidden_modules =
    jarvis.backtest
    jarvis.statistics
    jarvis.robustness
    jarvis.execution
